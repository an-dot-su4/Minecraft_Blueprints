{
  "name": "minecraft-blueprints",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply minecraft-blueprints --local",
    "db:migrate:remote": "wrangler d1 migrations apply minecraft-blueprints --remote"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
